# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sunn monorepo — vendored forge build outputs (mirror forge/.gitignore)
# the C sources live in /forge, but outputs are never committed
/forge/build/
/forge/target/
/forge/test/target/
/forge/*.exe
/forge/**/*.o
/forge/**/*.a
/forge/**/*.lib
/vendors/*/build/
/vendors/*/target/
