{
  "name": "registry-template",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.1"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "@modelcontextprotocol/sdk>zod": "^4",
    "zod-to-json-schema>zod": "^4",
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "lint": "eslint .",
    "registry:build": "shadcn build",
    "forge:build": "make -C forge CC=gcc",
    "forge:test": "make -C forge test",
    "forge:clean": "make -C forge clean",
    "sync:forge": "powershell -ExecutionPolicy Bypass -File scripts/sync-forge.ps1",
    "packages:fixtures": "python scripts/package_registry_fixtures.py"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-query": "^5.64.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^0.471.1",
    "next": "15.1.9",
    "next-themes": "^0.4.4",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "4.21.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.9",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
